pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'GitHub repository is connected!'
            }
        }

        stage('Build') {
            steps {
                echo 'Build stage is running!'
            }
        }

        stage('Success') {
            steps {
                echo 'Jenkins Pipeline completed!'
            }
        }
    }
}
